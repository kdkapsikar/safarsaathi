# Copy to .env and fill in as needed. Never commit .env.
# Everything works with no values set: `npm run dev` uses defaults.

# API server
API_PORT=3001
API_HOST=127.0.0.1
LOG_LEVEL=info

# SQLite database file (relative to the repo root). The data/ folder is git-ignored.
DATABASE_PATH=data/safar-saathi.db

# Auth
# Origins allowed to make state-changing requests (comma-separated).
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_DAYS=30
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Max login/register attempts per IP per window.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Train data. Default: the built-in simulator (no account needed). See docs/data-source.md.
TRAIN_PROVIDER=mock
# For TRAIN_PROVIDER=http:
# TRAIN_API_BASE_URL=https://your-adapter.example/api
# TRAIN_API_KEY=
# TRAIN_API_KEY_HEADER=x-api-key
# TRAIN_API_CAPABILITIES=liveStatus,schedule,platforms
TRAIN_CACHE_TTL_SECONDS=60
TRAIN_TIMEOUT_MS=4000
TRAIN_RETRIES=2
TRAIN_BREAKER_THRESHOLD=5
TRAIN_BREAKER_COOLDOWN_SECONDS=30
# Dev-only simulator controls (defaults to on with the mock provider outside production).
# ENABLE_SIMULATOR=true

# Alert engine (runs inside the API process)
ENABLE_ALERT_ENGINE=true
ALERT_ENGINE_CRON=* * * * *
# Email: only "dry-run" (logs what would be sent) exists so far; "off" disables email.
EMAIL_MODE=dry-run

# Website assistant (Saathi). Without ANTHROPIC_API_KEY, an offline scripted assistant answers
# using the same tools, so the preview needs no account.
# ANTHROPIC_API_KEY=
# Model ID (required with a key; never hard-coded in the app):
ASSISTANT_MODEL=claude-opus-5-5
# Thinking depth/cost: low | medium | high | xhigh | max
ASSISTANT_EFFORT=low
ASSISTANT_MAX_TOKENS=4096
ASSISTANT_MAX_TOOL_ROUNDS=5
# If the model declines a request, let the API retry it on a fallback model.
ASSISTANT_REFUSAL_FALLBACK=true
ASSISTANT_USER_HOURLY_LIMIT=40
ASSISTANT_IP_HOURLY_LIMIT=20
# Daily cost cap (input + output tokens, all users). Past it, Saathi switches to basic mode for the day.
ASSISTANT_DAILY_TOKEN_CAP=2000000
ASSISTANT_HISTORY_TURNS=8
